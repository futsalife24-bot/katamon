# Content Studio GitHub backend only. Do not put these values in Vite PUBLIC_* variables.
# Set VITE_REPOSITORY_MODE=server only in the PWA build environment to enable
# this backend. It is a public mode flag, never a credential.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
PUBLIC_APP_URL=http://localhost:4174

# GitHub OAuth App: identifies the signed-in administrator.
GITHUB_OAUTH_CLIENT_ID=replace-with-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# GitHub App: writes only to the fixed installation and repository below.
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY=replace-with-private-key-pem-using-escaped-newlines
GITHUB_INSTALLATION_ID=12345678
GITHUB_OWNER=target-owner
GITHUB_REPO=target-repository
GITHUB_BASE_BRANCH=master
ALLOWED_GITHUB_USERS=allowed-user

# Generate at least 32 random characters. Never commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional hardening and size limits.
TRUST_PROXY=false
ADDITIONAL_ALLOWED_ORIGINS=
GITHUB_ALLOWED_EXACT_FILES=
SESSION_TTL_SECONDS=28800
OAUTH_STATE_TTL_SECONDS=600
PREPARATION_TTL_SECONDS=1800
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=60
MAX_REQUEST_BYTES=25165824
MAX_FILE_BYTES=6291456
MAX_TOTAL_FILE_BYTES=16777216
MAX_FILES=32
MAX_IMAGE_DIMENSION=8192
MAX_IMAGE_PIXELS=16777216
