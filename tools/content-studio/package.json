{
  "name": "content-studio",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/normalize-dist.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "server:dev": "tsx server/index.ts",
    "server:build": "tsc -p tsconfig.server.json && esbuild ./server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=server-dist/index.js",
    "server:start": "node server-dist/index.js",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "generate:catalog": "tsx scripts/generate-game-content.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
